#!/usr/bin/env bash
set -euo pipefail

if command -v apt-get >/dev/null 2>&1; then
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y jq gzip curl
else
  yum install -y awscli jq gzip curl
fi
command -v aws >/dev/null
systemctl enable --now docker

mkdir -p /opt/dai/model /opt/dai/results /opt/dai/hf-cache
echo '${node_rank}' > /opt/dai/node-rank
echo '${result_bucket}' > /opt/dai/result-bucket
echo '${generation_benchmark_gz_b64}' | base64 -d | gzip -dc > /opt/dai/generation_benchmark.py
echo '${qwen3_placement_patch_gz_b64}' | base64 -d | gzip -dc > /opt/dai/apply_sglang_qwen3_placement_patch.py
echo '${benchmark_prompt_gz_b64}' | base64 -d | gzip -dc > /opt/dai/benchmark-prompt.md
chmod 0755 /opt/dai/generation_benchmark.py /opt/dai/apply_sglang_qwen3_placement_patch.py

cat > /etc/systemd/system/dai-ttl-terminate.service <<'UNIT'
[Unit]
Description=Terminate the dAI experiment worker after its hard TTL

[Service]
Type=oneshot
ExecStart=/sbin/shutdown -h now
UNIT

cat > /etc/systemd/system/dai-ttl-terminate.timer <<'UNIT'
[Unit]
Description=Hard TTL for the dAI experiment worker

[Timer]
OnBootSec=${ttl_minutes}min
Unit=dai-ttl-terminate.service

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now dai-ttl-terminate.timer

aws s3 sync "s3://${model_bucket}/${model_prefix}/" /opt/dai/model/ \
  --region '${aws_region}' --only-show-errors
test -s /opt/dai/model/model.safetensors.index.json
test -s /opt/dai/model/model-00016-of-00016.safetensors

docker pull '${sglang_image}'
DAI_PATCH_CONTAINER=$(docker create '${sglang_image}')
docker cp "$DAI_PATCH_CONTAINER:/sgl-workspace/sglang/python/sglang/srt/models/qwen3_moe.py" /opt/dai/qwen3_moe.py
docker rm "$DAI_PATCH_CONTAINER"
python3 /opt/dai/apply_sglang_qwen3_placement_patch.py /opt/dai/qwen3_moe.py > /opt/dai/qwen3-moe-patch-sha256.txt
docker image inspect '${sglang_image}' > /opt/dai/sglang-image.json
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader > /opt/dai/gpu-contract.csv
grep -Eq '^NVIDIA L4,' /opt/dai/gpu-contract.csv
DAI_GPU_MIB=$(awk -F, '{gsub(/ MiB| /, "", $2); print $2}' /opt/dai/gpu-contract.csv)
test "$DAI_GPU_MIB" -ge 22000
test "$DAI_GPU_MIB" -le 24576
touch /opt/dai/ready
